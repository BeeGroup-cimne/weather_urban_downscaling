FROM pytorch/pytorch:2.1.2-cuda11.8-cudnn8-devel

# Metadata
LABEL maintainer="your-email@example.com"
LABEL description="PyTorch environment for Weather Urban Downscaling with Mamba SSM"

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_BUILD_ISOLATION=1
WORKDIR /app

# Install system dependencies
# ninja-build is required for mamba-ssm compilation
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    ninja-build \
    libeccodes-dev \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements_torch.txt .
COPY requirements_mamba.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir packaging && \
    pip install --no-cache-dir -r requirements_torch.txt && \
    pip install --no-cache-dir --no-build-isolation -r requirements_mamba.txt

# Copy project code
COPY config/ ./config/
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY train.py .

# Environment variables
ENV PYTHONPATH="${PYTHONPATH}:/app"
ENV PYTHONUNBUFFERED=1

# Create necessary directories
RUN mkdir -p /app/data/processed/era5land \
    /app/data/raw \
    /app/experiments/models \
    /app/experiments/logs \
    /app/experiments/figures

# Default command
CMD ["python", "scripts/train_torch.py"]
