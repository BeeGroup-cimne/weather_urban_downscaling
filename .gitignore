# =============================================================
# Git ignore — Weather Urban Downscaling (Server-Ready)
# =============================================================

# ----- Images / figures -----
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.pdf

# ----- Data files (too large for git) -----
*.nc
*.grib
*.zarr/
*.npy
*.npz
*.h5
*.keras
*.geojson

# ----- Data directories -----
data/raw/*
data/processed/*
data/static/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/era5land/.gitkeep
!data/static/.gitkeep

# ----- Experiment outputs (regenerable) -----
experiments/*.csv
experiments/*.json
experiments/models/*
experiments/logs/*
experiments/figures/*
experiments/paper_figures/*
experiments/ab_compare/*
experiments/tf/*
experiments/torch/*
!experiments/models/.gitkeep
!experiments/logs/.gitkeep
!experiments/figures/.gitkeep

# ----- Archive / legacy (not needed on server) -----
archive/

# ----- Cache / temp -----
.cache/
.pycache/
processed_cache_zarr/
src/utils/cache/
.tmp_mpl/
.mplconfig/

# ----- Non-production / WIP -----
future_projects/
reports/

# ----- Root-level files not needed on server -----
cronograma_tesis_final.png
generar_cronograma.py
check_architecture.py
ablation_results.md
train.py

# ----- Redundant requirements (only requirements_tf.txt is needed) -----
requirements.txt
requirements_mac.txt
requirements_mamba.txt
requirements_torch.txt
environment_torch.yml

# ----- Python -----
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ----- Virtual environments -----
.venv/
venv/
ENV/
env/

# ----- IDE -----
.idea/
.vscode/
*.swp
*.swo

# ----- OS -----
.DS_Store
Thumbs.db

# ----- Jupyter -----
.ipynb_checkpoints/

# ----- Misc -----
*.log
*.tmp
*.bak

# ----- IDX (Google Cloud IDE) -----
.idx/

# ----- Scripts not needed for server (figure generators, etc.) -----
scripts/generate_latex_architecture_gallery.py
scripts/generate_paper_architecture_figures.py
scripts/generate_paper_block_diagrams.py
scripts/generate_paper_figure3_like.py
scripts/generate_paper_flow_figures.py
scripts/generate_paper_figures.py

# Local/Server runs
experiments/
scripts/experiments/

# ----- Operational & planning docs (not for external reproducibility) -----
docs/PHASE_H_*
docs/PENDING_*
docs/POSTTRAINING_*
docs/HIGH_RANKING_*
docs/SERVER_REFRESH_*
docs/q1_upgrade/
docs/SERVER_ROADMAP.md
plans/
exp_01/
.roo/
figures_final_paper/

# ----- Root-level server runner scripts -----
deploy_gpu_server.sh
run-local.sh
run_*.sh

# ----- Server-specific config overrides -----
config/eval_config_exp3_*
config/eval_config_refresh_*
config/gpu_server_config.py

# ----- Paper (LaTeX sources - kept local, not for public repo) -----
Paper/

# ----- Figure authoring intermediates -----
figures/final_all_images/authoring/
figures/final_all_images/candidates_flow/

# ----- Forecast data (large, regenerable from OpenMeteo) -----
data/forecast/

# ----- IDE (Warp) -----
.warp/

# ----- Local evaluation reports (not for public repo) -----
EVALUACION_CR_BCN.md
evaluacion_adversaria_CR_BCN.md

# ----- Benchmark results (regenerable run outputs) -----
model_benchmark/results/

# Local benchmark config: holds an OpenRouter API key.
# Create it with `cp config.json.example config.json` (see model_benchmark/README.md).
model_benchmark/config.json

# ----- Diagnostic / one-off investigation scripts -----
scripts/diagnostics/
