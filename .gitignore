# Git ignore patterns

# Data files (too large for git)
*.nc
*.grib
*.zarr/
*.npy
*.npz
*.h5
*.keras
*.geojson

# Data directories
data/raw/*
data/processed/*
data/static/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/era5land/.gitkeep

# Experiment outputs (can be regenerated)
experiments/models/*
experiments/logs/*
experiments/figures/*
!experiments/models/.gitkeep
!experiments/logs/.gitkeep
!experiments/figures/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Misc
*.log
*.tmp
*.bak

# IDX (Google Cloud IDE)
.idx/